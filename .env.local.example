# Copy this file to .env.local before running the app.

# --- NextAuth.js ---
# Generate a real secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-string
NEXTAUTH_URL=http://localhost:3000

# --- MySQL connection ---
# These defaults match MAMP's default MySQL settings (find yours under
# MAMP's "Preferences" or the MAMP start page's connection-parameters
# panel). Standalone MySQL installs usually default to port 3306
# instead — check yours if this doesn't connect.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=8889
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=nextjs_notes_demo
